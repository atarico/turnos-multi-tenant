# Plantilla de variables de entorno. Copiala a `.env.local` y completá los
# valores reales. NO pongas secretos en este archivo: es la referencia pública.

# --- Supabase (cliente) ---
# Se toman del proyecto de Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Supabase (servidor) ---
# service_role NUNCA se expone al cliente. Se usa solo en el servidor para las
# operaciones que la anon key ya no puede ejecutar (p. ej. el freno de reservas).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Anti-spam de reservas anónimas ---
# Salt para hashear la IP del visitante antes de guardarla. Inventá una cadena
# larga y aleatoria (mínimo 16 caracteres; recomendado 32+). Sin salt, las IPs
# se reconstruyen por fuerza bruta desde la base.
BOOKING_IP_SALT=cambiar-por-una-cadena-larga-y-aleatoria
